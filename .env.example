# Groq Free-plan starter. Copy this file to .env; keep .env private.
# Leave SZ_MODEL empty to keep the deterministic demo running.
# After adding your key, set SZ_MODEL=openai/gpt-oss-20b and restart.
SZ_MODEL=
SZ_MODEL_BASE_URL=https://api.groq.com/openai/v1
SZ_MODEL_API_KEY=

# This application cannot verify your provider billing tier.
# Use Groq's Free plan. Quota errors stop the run; no automatic retries/fallbacks.
